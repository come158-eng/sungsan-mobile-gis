/*
 * Sungsan VWorld basemap plugin
 * SPDX-License-Identifier: GPL-2.0-or-later
 *
 * VWorld tiles are online-only. This plugin does not prefetch or bulk-cache tiles.
 */
import QtQuick
import org.qfield

Item {
  id: root

  readonly property string layerName: "VWorld 위성영상 · 출처: 국토교통부 브이월드"
  readonly property string vworldSource: "type=xyz&tilePixelRatio=1&url=https://api.vworld.kr/req/wmts/1.0.0/@SUNG_SAN_VWORLD_API_KEY@/Satellite/%7Bz%7D/%7By%7D/%7Bx%7D.jpeg&zmax=19&zmin=6&crs=EPSG3857"

  function hasVWorldLayer() {
    const layers = ProjectUtils.mapLayers(qgisProject);
    for (const layerId in layers) {
      const layer = layers[layerId];
      if (layer && (layer.name === layerName || ProjectUtils.isVWorldSatelliteLayer(layer))) {
        return true;
      }
    }
    return false;
  }

  function ensureVWorldLayer() {
    if (!qgisProject || !qgisProject.fileName || hasVWorldLayer()) {
      return;
    }

    const layer = LayerUtils.loadRasterLayer(vworldSource, layerName, "wms");
    if (!layer || layer.isValid === false) {
      if (layer) {
        layer.deleteLater();
      }
      iface.logMessage("Meta Engineering GIS: VWorld 위성영상 레이어를 만들지 못했습니다.");
      return;
    }

    if (!ProjectUtils.addMapLayerAtBottom(qgisProject, layer)) {
      iface.logMessage("Meta Engineering GIS: VWorld 위성영상 레이어를 프로젝트에 추가하지 못했습니다.");
    }
  }

  Connections {
    target: iface

    function onLoadProjectEnded(path, name) {
      Qt.callLater(root.ensureVWorldLayer);
    }
  }

  Component.onCompleted: Qt.callLater(root.ensureVWorldLayer)
}
